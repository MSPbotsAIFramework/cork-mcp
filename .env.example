# Non-credential runtime settings only. The Cork API key is never read from
# the environment -- it comes from the X-Cork-Api-Key request header on
# every call (see src/cork_mcp/server.py). Do not add a credential here.
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
CORK_BASE_URL=https://api.corkinc.com/api/v1
